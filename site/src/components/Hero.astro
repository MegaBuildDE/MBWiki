---
// Startseite: großes Titelbild (cover aus README.md) mit Verlauf darüber, statt Starlights Bild-rechts-Hero.
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const style = data.cover ? `--mb-hero-image: url("${data.cover}")` : undefined;
---

<section class="mb-hero" style={style}>
	<div class="mb-hero__inner">
		<p class="mb-hero__kicker">MegaBuild.de · Custom Skyblock</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="mb-hero__tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="mb-hero__actions">
					{actions.map(({ text, link, variant, icon, attrs = {} }) => (
						<LinkButton href={link} variant={variant} icon={icon?.name} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.mb-hero {
		position: relative;
		overflow: hidden;
		margin-block: 1rem 2.5rem;
		border-radius: 1.5rem;
		border: 1px solid var(--mb-color-border);
		background:
			linear-gradient(90deg, rgba(23, 13, 41, 0.94) 0%, rgba(23, 13, 41, 0.72) 45%, rgba(23, 13, 41, 0.15) 100%),
			linear-gradient(0deg, rgba(23, 13, 41, 0.85) 0%, transparent 45%),
			var(--mb-hero-image, none) center / cover no-repeat,
			var(--mb-color-bg-soft);
		box-shadow: var(--mb-shadow-soft);
	}
	.mb-hero__inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: clamp(2rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem);
		max-width: 44rem;
	}
	.mb-hero__kicker {
		margin: 0;
		color: var(--mb-color-primary);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-3xl), calc(0.5rem + 4vw), var(--sl-text-5xl));
		line-height: 1.1;
		font-weight: 700;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.mb-hero__tagline {
		margin: 0;
		font-size: clamp(var(--sl-text-base), calc(0.25rem + 1.5vw), var(--sl-text-xl));
		color: var(--mb-color-text-soft);
		text-wrap: pretty;
	}
	.mb-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 0.75rem;
	}
</style>
