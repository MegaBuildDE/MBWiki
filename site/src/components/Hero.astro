---
// Startseite: großes Titelbild (cover aus README.md) über die ganze Breite, statt Starlights Bild-rechts-Hero.
// Breite: mb.css hebt auf Seiten mit Hero die Inhaltsbreite auf, das Bild füllt also immer den Platz neben der Seitenleiste.
import { LinkButton } from '@astrojs/starlight/components';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const style = data.cover ? `--mb-hero-image: url("${data.cover}")` : undefined;
---

<section class="mb-hero" style={style}>
	<div class="mb-hero__inner">
		<p class="mb-hero__kicker">MegaBuild.de · Custom Skyblock</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="mb-hero__tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="mb-hero__actions">
					{actions.map(({ text, link, variant, icon, attrs = {} }) => (
						<LinkButton href={link} variant={variant} icon={icon?.name} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.mb-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		align-items: center;
		min-height: clamp(20rem, 30vw, 32rem);
		margin-block: 0.5rem 2rem;
		border-radius: 1.25rem;
		border: 1px solid var(--mb-color-border);
		background:
			linear-gradient(90deg, rgba(23, 13, 41, 0.95) 0%, rgba(23, 13, 41, 0.82) 40%, rgba(23, 13, 41, 0.15) 80%),
			linear-gradient(0deg, rgba(23, 13, 41, 0.8) 0%, transparent 40%),
			var(--mb-hero-image, none) center 40% / cover no-repeat,
			var(--mb-color-bg-soft);
		box-shadow: var(--mb-shadow-soft);
	}

	.mb-hero__inner {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		width: 100%;
		max-width: min(46rem, 66%);
		padding: clamp(2rem, 4vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
	}

	.mb-hero__kicker {
		margin: 0;
		color: var(--mb-color-primary);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-3xl), calc(0.5rem + 3vw), var(--sl-text-5xl));
		line-height: 1.1;
		font-weight: 700;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.mb-hero__tagline {
		margin: 0;
		max-width: 38rem;
		font-size: clamp(var(--sl-text-base), calc(0.4rem + 1vw), var(--sl-text-xl));
		color: var(--mb-color-text-soft);
		text-wrap: pretty;
	}

	.mb-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.75rem;
		margin-top: 0.5rem;
	}

	.mb-hero__actions :global(.sl-link-button) {
		margin: 0;
	}

	/* Handy: Bild von Rand zu Rand direkt unter der Kopfzeile, blendet nach unten aus, Text darunter. */
	@media (max-width: 49.99rem) {
		.mb-hero {
			display: block;
			min-height: 0;
			margin: -1.5rem calc(-1 * var(--sl-content-pad-x)) 0.5rem;
			border: 0;
			border-radius: 0;
			background: none;
			box-shadow: none;
		}

		.mb-hero::before {
			content: '';
			position: absolute;
			inset: 0 0 auto;
			z-index: -1;
			aspect-ratio: 16 / 10;
			background:
				linear-gradient(180deg, transparent 35%, rgba(23, 13, 41, 0.55) 75%),
				var(--mb-hero-image, none) center / cover no-repeat;
			mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
		}

		.mb-hero__inner {
			gap: 0.7rem;
			max-width: none;
			padding: calc(62.5vw - 6rem) var(--sl-content-pad-x) 0.5rem;
		}

		.mb-hero__kicker {
			font-size: var(--sl-text-xs);
			text-shadow: 0 1px 10px rgba(23, 13, 41, 0.9);
		}

		h1 {
			font-size: clamp(1.75rem, 7.5vw, 2.4rem);
			text-shadow: 0 2px 18px rgba(23, 13, 41, 0.8);
		}

		.mb-hero__tagline {
			font-size: var(--sl-text-base);
		}

		.mb-hero__actions {
			margin-top: 0.35rem;
		}

		.mb-hero__actions :global(.sl-link-button) {
			flex: 1 1 9rem;
			max-width: 16rem;
			justify-content: center;
		}
	}

	/* Ohne Titelbild (z. B. 404) kein leerer Bildbereich auf dem Handy. */
	@media (max-width: 49.99rem) {
		.mb-hero:not([style])::before {
			display: none;
		}

		.mb-hero:not([style]) .mb-hero__inner {
			padding-top: 2rem;
		}
	}
</style>
